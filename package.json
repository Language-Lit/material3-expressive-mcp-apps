{
  "name": "@language-lit/material3-expressive-mcp-apps",
  "version": "0.1.0",
  "description": "MCP Apps for Material 3 Expressive: a Material host frame that embeds MCP Apps in agent surfaces, and an app provider that lets an MCP App built with the design system follow the host's theme, display mode and safe areas.",
  "license": "MIT",
  "homepage": "https://m3e.language-lit.com/mcp-apps/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Lit/material3-expressive-mcp-apps.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-directives.mjs && npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts --port 5473 --strictPort",
    "playground:build": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:package",
    "preplayground": "node scripts/build-playground-app.mjs",
    "preplayground:build": "node scripts/build-playground-app.mjs",
    "pretypecheck": "node scripts/build-playground-app.mjs",
    "test:browser": "node scripts/audit-playground.mjs"
  },
  "peerDependencies": {
    "@language-lit/material3-expressive": "^1.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@language-lit/material3-expressive": "^1.2.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "zod": "^4.2.0",
    "esbuild": "0.27.7",
    "playwright-core": "1.62.1"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "material-design",
    "material-3",
    "material-3-expressive",
    "react",
    "design-system",
    "agent-ui"
  ],
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 121",
    "Safari >= 17.2",
    "iOS >= 17.2"
  ]
}
